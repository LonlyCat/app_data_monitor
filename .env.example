# Django设置
DEBUG=True
SECRET_KEY=django-insecure-development-key-only
ALLOWED_HOSTS=localhost,127.0.0.1

# 数据库设置
DB_HOST=db
DB_NAME=app_monitor
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# SQLite数据库设置（用于本地开发，无需安装PostgreSQL）
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# 加密密钥（用于加密敏感数据）
# 运行以下命令生成新的加密密钥：
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-encryption-key-here

# 日志级别
DJANGO_LOG_LEVEL=INFO

# 数据获取延迟天数（等待Apple/Google处理数据的时间）
DATA_FETCH_DELAY_DAYS=2

# App Store Connect API设置（可选）
# APP_STORE_CONNECT_KEY_ID=your-key-id
# APP_STORE_CONNECT_ISSUER_ID=your-issuer-id
# APP_STORE_CONNECT_PRIVATE_KEY_PATH=path/to/private-key.p8

# Google Play Console API设置（可选）
# GOOGLE_PLAY_SERVICE_ACCOUNT_KEY_PATH=path/to/service-account-key.json

# 飞书通知设置（可选）
# LARK_APP_ID=your-lark-app-id
# LARK_APP_SECRET=your-lark-app-secret
# LARK_CHAT_ID=your-chat-id
