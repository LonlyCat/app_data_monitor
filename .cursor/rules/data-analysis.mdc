def validate_algorithm(self, test_data, expected_results):
    """算法验证"""
    # 执行算法
    actual_results = self.run_algorithm(test_data)
    
    # 比较结果
    accuracy = self._calculate_accuracy(actual_results, expected_results)
    
    # 性能测试
    performance_metrics = self._measure_performance(test_data)
    
    return {
        'accuracy': accuracy,
        'performance': performance_metrics
    }
```

