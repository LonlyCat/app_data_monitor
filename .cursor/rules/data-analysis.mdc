def preprocess_data(self, raw_data):
    """数据预处理"""
    # 数据清洗逻辑
    cleaned_data = self._clean_data(raw_data)
    
    # 缺失值处理
    filled_data = self._fill_missing_values(cleaned_data)
    
    # 数据标准化
    normalized_data = self._normalize_data(filled_data)
    
    return normalized_data
